# The oldest Home Assistant that Home Keeper Library supports. This is the only place
# that names it. CI tests it on every PR. hacs.json, the README badge and the install
# guide must match it (tests/unit/test_oldest_ha.py checks that).
#
# To drop an old version: change these lines, hacs.json, the README badge and the
# install guide, and add a CHANGELOG entry. To find the matching test package for a
# new version, read the "homeassistant==" pin of pytest-homeassistant-custom-component
# on PyPI. OLDEST_HA is also the Docker image tag of the integration tests.
OLDEST_HA=2026.9.4
OLDEST_HA_MIN=2026.9.0
OLDEST_PHCC=0.13.367
OLDEST_PYTHON=3.14
